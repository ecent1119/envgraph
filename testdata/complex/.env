# Application
NODE_ENV=development

# Database - note: case collision with db_user
DB_USER=appuser
DB_PASSWORD=secret
DB_NAME=myapp
DATABASE_URL=postgres://appuser:secret@db:5432/myapp

# Auth
AUTH_SECRET=super-secret-key

# Cache
REDIS_PASSWORD=redispass

# Worker
WORKER_CONCURRENCY=2

# Unused variable (should trigger warning)
LEGACY_API_KEY=deprecated
OLD_CONFIG_PATH=/etc/old

# Variable with quotes
QUOTED_VAR="value with spaces"
SINGLE_QUOTED='another value'

# Variable with export prefix
export EXPORTED_VAR=exported_value

# Case collision test
Db_User=collision_test

# Defined here but overridden by compose inline
SHARED_VAR=from-env-file
